# Standard .gitignore for Go, React, and macOS

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs and Editors
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# Go — compiled binaries
bin/
obj/
server
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Node.js / React
node_modules/
build/
dist/
dist-ssr/
.eslintcache
.next/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables
.env
.env.local
.env.*.local

# Databases (runtime)
data/
*.db
*.sqlite
*.sqlite3

# Temp
tmp/
.temp/
